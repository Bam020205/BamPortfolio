{
  "framework": null,
  "installCommand": "npm ci --include=dev --include=optional",
  "buildCommand": "npm run build && mkdir -p dist && cp -R about admin certifications content contact experience journal media overview projects index.html headings.css journal.css reactor.css site.css site.js visits.js wallet.css wallet.js dist/",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "bamportfolio-two.vercel.app" }],
      "destination": "https://abramseneca.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path+/",
      "has": [{ "type": "host", "value": "bamportfolio-two.vercel.app" }],
      "destination": "https://abramseneca.vercel.app/:path/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "bamportfolio-two.vercel.app" }],
      "destination": "https://abramseneca.vercel.app/:path*",
      "permanent": true
    }
  ]
}
